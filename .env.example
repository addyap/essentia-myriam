# Identifiant public du site fourni par DecapBridge après sa création.
# Ne placez jamais de token GitHub ni de mot de passe ici.
DECAPBRIDGE_SITE_ID=

# Formulaire de contact (Resend). Clé API créée dans Resend, à saisir dans
# Vercel → Settings → Environment Variables, jamais dans ce fichier.
RESEND_API_KEY=
# Protection du formulaire : valeur aléatoire d’au moins 32 caractères, à saisir
# dans Vercel uniquement (par exemple : openssl rand -base64 48). Sans elle, une
# clé est dérivée de RESEND_API_KEY.
FORM_SECRET=
# Facultatif : expéditeur sur le domaine vérifié dans Resend.
# Par défaut : Essentia de Myriam Diougoan Blanch <contact@essentiademdb.com>
CONTACT_FROM=
